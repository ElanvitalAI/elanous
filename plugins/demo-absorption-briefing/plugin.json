{
  "$schema": "https://antigravity.google/schemas/v1/plugin.json",
  "name": "demo-absorption-briefing",
  "version": "0.1.0",
  "description": "Absorption briefing scene package: topic subscriptions, scheduled runs, issue briefs, and reopen follow-up.",
  "extensions": {
    "ai.elanous": {
      "connectors": [
        { "id": "exa", "required": false, "fields": [{ "name": "apiKey", "secret": true, "env": "EXA_API_KEY" }] },
        { "id": "firecrawl", "required": false, "fields": [{ "name": "apiKey", "secret": true, "env": "FIRECRAWL_API_KEY" }] },
        { "id": "xai", "required": false, "fields": [{ "name": "apiKey", "secret": true, "env": "XAI_API_KEY" }] },
        { "id": "telegram", "required": false, "fields": [{ "name": "botToken", "secret": true, "env": "ELANOUS_TELEGRAM_BOT_TOKEN" }] },
        { "id": "telegram-chat", "required": false, "fields": [{ "name": "chatId", "secret": false, "env": "ELANOUS_TELEGRAM_CHAT_ID" }] },
        { "id": "linear", "required": false, "fields": [{ "name": "apiKey", "secret": true, "env": "LINEAR_API_KEY" }] }
      ]
    }
  }
}
