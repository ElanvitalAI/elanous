{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elanous.local/schemas/architecture-deliverables/structured-design-v1.json",
  "title": "System architecture structured design input v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "version",
    "summary",
    "background",
    "deployment",
    "nodes",
    "flows",
    "requirements",
    "security",
    "capacity",
    "costs",
    "savings",
    "alternatives",
    "decisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "background": {
      "type": "string",
      "minLength": 1
    },
    "deployment": {
      "type": "object",
      "required": [
        "provider",
        "project",
        "region",
        "vpc"
      ],
      "properties": {
        "provider": {
          "enum": ["generic", "gcp"]
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "vpc": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "layer",
          "zone",
          "service"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "users",
              "edge",
              "application",
              "data",
              "observability",
              "security"
            ]
          },
          "zone": {
            "enum": [
              "external",
              "project",
              "vpc"
            ]
          },
          "service": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 2
          },
          "icon": {
            "type": "string",
            "description": "Exact PNG sourcePath in references/official-gcp-icons.json; at least three nodes need icons."
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "label",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "sync",
              "async",
              "telemetry"
            ]
          }
        }
      },
      "maxItems": 9
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "statement",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "security": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "class",
          "data",
          "controls"
        ],
        "properties": {
          "class": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "string",
            "minLength": 1
          },
          "controls": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capacity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item",
          "assumption",
          "verification"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "assumption": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "savings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "mechanism",
          "guardrail"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "guardrail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "when",
          "tradeoff"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "tradeoff": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "decision",
          "rationale",
          "revisit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "revisit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "costs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item",
          "formula",
          "monthlyUsd"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "formula": {
            "type": "string",
            "minLength": 1
          },
          "monthlyUsd": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
