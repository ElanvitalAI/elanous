{
  "$schema": "https://antigravity.google/schemas/v1/plugin.json",
  "name": "architecture-deliverables",
  "version": "0.1.0",
  "dependencies": {
    "runtime": [
      { "kind": "uv-python", "project": "@distribution/skills/diagram-master/references", "extras": ["python-engines"], "browser": "chromium" }
    ]
  },
  "description": "Generates editable system architecture diagrams and integrated PDFs from structured design JSON (nodes, zones, flows, tables).",
  "contributes": {
    "aiTools": [{
      "name": "architecture_deliverables",
      "description": "Render a requirements-derived structured system design into editable Excalidraw and draw.io diagrams, SVG and PNG exports, and an integrated architecture PDF. Use after creating structured design JSON with nodes, zones, flows and decision tables; no cloud resources are created.",
      "handler": "graph:architecture-deliverables",
      "parameters": {
        "type": "object",
        "properties": {
          "structuredDesignPath": { "type": "string", "description": "Existing absolute path to structured design JSON" },
          "outDir": { "type": "string", "description": "Absolute directory for verified artifacts" },
          "resourceRoot": { "type": "string", "description": "Absolute repository path containing diagram and PDF renderers" }
        },
        "required": ["structuredDesignPath"],
        "additionalProperties": false
      },
      "route": {
        "triggers": ["시스템 아키텍처 도식", "draw.io 설계도", "Excalidraw 설계도", "architecture deliverables"],
        "examples": ["구조화 설계 JSON으로 편집 가능한 아키텍처 도식과 PDF를 만들어줘", "이 설계에서 draw.io와 SVG를 내보내줘"],
        "sideEffects": "mutating",
        "risk": "medium",
        "cost": "spawns-run",
        "requiresConfirm": false
      }
    }]
  },
  "extensions": {
    "ai.elanous": {
      "graphs": [
        "./graphs/architecture-deliverables.yaml"
      ],
      "graphProviders": {
        "./graphs/architecture-deliverables.yaml": {
          "module": "src/graph-runner/capability-providers/architecture-deliverables.ts",
          "factory": "createArchitectureDeliverablesRegistry",
          "withPluginRoot": true
        }
      },
      "outputContract": {
        "appliesTo": [
          "system-architecture",
          "system-architecture-on-gcp",
          "gcp-cloud-expansion"
        ],
        "requiredFiles": [
          "architecture.excalidraw",
          "architecture.drawio",
          "architecture.svg",
          "architecture.png",
          "architecture.html",
          "architecture.pdf",
          "verification.json"
        ],
        "pdfSections": [
          "배경",
          "요구사항",
          "구성도",
          "데이터 흐름",
          "보안 등급",
          "비용 예측",
          "절감안",
          "대안",
          "결정 기록"
        ],
        "diagramQuality": {
          "iconSource": "Local/generic: editable shapes. GCP: official core/category icons. AWS: official Architecture Icons. Cloud source path and SHA-256 verified",
          "layers": [
            "users",
            "edge",
            "application",
            "data",
            "observability",
            "security"
          ],
          "boundaries": [
            "system/project/account",
          "zone/region",
          "network/VPC"
          ],
          "annotations": [
            "numbered data flows",
            "legend",
            "title",
            "version"
          ]
        },
        "pdfQuality": [
          "cover",
          "table of contents",
          "executive summary",
          "embedded diagram",
          "tables",
          "appendix"
        ],
        "referenceStyle": [
          "https://cloud.google.com/icons",
          "https://aws.amazon.com/architecture/icons/",
          "https://docs.aws.amazon.com/reference-architecture-diagrams/"
        ],
        "completionRule": "All required files exist, editable Excalidraw and draw.io XML plus SVG derive from the same validated source, nested boundary and flow shapes are present, and the integrated PDF has cover, contents, summary, body, tables, and appendix. Cloud modes verify official icon bytes."
      },
      "capabilities": [
        "fs:workdir",
        "proc:bun",
        "proc:uv",
        "proc:python"
      ],
      "connectors": [],
      "pricing": {
        "model": "free"
      },
      "trust": "official",
      "category": "Productivity",
      "inputContract": {
        "defaultMode": "structured",
        "inputKeys": ["structuredDesignPath", "outDir", "resourceRoot"],
        "graphApiVersion": "elanous.dev/graph/v2",
        "structuredDesignPath": "Absolute path to JSON conforming to references/structured-design.schema.json",
        "legacyFinishedInputs": [
          "designHtmlPath",
          "diagramSourcePath"
        ],
        "resourceRoot": "Absolute path to existing repository skills used by diagram-master and PDF converter"
      }
    }
  }
}
