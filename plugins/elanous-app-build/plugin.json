{
  "id": "elanous-app-build",
  "name": "Staged App Planning",
  "version": "0.1.0",
  "description": "Plan a general application through fixed assumptions, architecture and file-contract graph stages using the configured model.",
  "whenToUse": "앱을 만들고 프론트엔드 백엔드 데이터베이스 아키텍처와 파일 계획을 순서대로 생성할 때 사용한다. Build application frontend backend database architecture and validated source plan without stopping for product clarification. This planning slice does not yet execute code or publish.",
  "inputs": {
    "ask": "User application request. Missing product choices become labeled assumptions.",
    "seedRequested": "True only when the user explicitly requested synthetic data."
  },
  "outputs": {
    "planning": "Validated assumptions, eight-section architecture and bounded file plan.",
    "buildComplete": "False: files, seed, test and publication require the downstream slices."
  },
  "examples": [
    "앱을 만들어서 가상 데이터로 채워 넣고 배포해줘",
    "Build a web application with frontend backend and database."
  ],
  "requires": {
    "memberConnection": true,
    "appKinds": [
      "local-service"
    ],
    "confirmation": false
  },
  "activationEvents": [
    "onRoute"
  ],
  "contributes": {
    "aiTools": [
      {
        "name": "app_build_plan",
        "description": "Run fixed application planning stages with the configured model: assumptions, complete architecture, then file plan. No clarification-question terminal. Returns buildComplete:false until downstream code/test/publish steps execute.",
        "handler": "graph:app-build-plan",
        "parameters": {
          "type": "object",
          "properties": {
            "ask": {
              "type": "string"
            },
            "seedRequested": {
              "type": "boolean"
            }
          },
          "required": [
            "ask",
            "seedRequested"
          ],
          "additionalProperties": false
        },
        "route": {
          "triggers": [
            "앱 만들어",
            "앱 설계",
            "build application",
            "create frontend backend database"
          ],
          "examples": [
            "Build a general web application architecture and source plan"
          ],
          "sideEffects": "mutating",
          "risk": "medium",
          "cost": "spends-llm",
          "requiresConfirm": false
        }
      },
      {
        "name": "app_build",
        "description": "설계와 파일 계획을 생성하고 코드를 작성·격리 시험한 뒤, 회원에게 승인된 앱을 게시한다. 권한·시험·게시 확인이 없으면 완료로 보지 않는다.",
        "handler": "graph:app-build",
        "parameters": {
          "type": "object",
          "properties": {
            "ask": {
              "type": "string"
            },
            "seedRequested": {
              "type": "boolean"
            },
            "appSlug": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,22}[a-z0-9])?$"
            },
            "artifactMetadata": {
              "type": "object",
              "properties": {
                "runtime": {
                  "type": "object",
                  "properties": {
                    "startCommand": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Bun entry: [bun, backend/entry.ts]. Export fetch(request); host starts the listener."
                    },
                    "port": {
                      "type": "integer"
                    },
                    "healthPath": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "startCommand",
                    "healthPath"
                  ],
                  "additionalProperties": false
                },
                "frontendRoot": {
                  "type": "string"
                },
                "apiPrefix": {
                  "type": "string"
                }
              },
              "required": [
                "runtime"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ask",
            "seedRequested",
            "appSlug",
            "artifactMetadata"
          ],
          "additionalProperties": false
        },
        "route": {
          "triggers": [
            "앱 만들고 배포",
            "프론트엔드 백엔드 배포",
            "build test publish application"
          ],
          "examples": [
            "Build a general application, test it and publish the approved result"
          ],
          "sideEffects": "mutating",
          "risk": "high",
          "cost": "spends-llm",
          "requiresConfirm": true
        }
      }
    ]
  },
  "extensions": {
    "ai.elanous": {
      "graphs": [
        "./graph/app-build-plan.yaml",
        "./graph/app-build.yaml"
      ],
      "graphProviders": {
        "./graph/app-build-plan.yaml": {
          "module": "src/graph-runner/capability-providers/source-planning.ts",
          "factory": "createSourcePlanningRegistry"
        },
        "./graph/app-build.yaml": {
          "module": "src/graph-runner/capability-providers/source-build.ts",
          "factory": "createSourceBuildRegistry"
        }
      }
    }
  }
}
