{
  "$schema": "https://antigravity.google/schemas/v1/plugin.json",
  "name": "demo-video-briefing",
  "version": "0.1.0",
  "description": "Video briefing scene package: turn a decision memo into a short video and deliver it.",
  "extensions": {
    "ai.elanous": {
      "connectors": [
        { "id": "elevenlabs", "required": false, "fields": [{ "name": "apiKey", "secret": true, "env": "ELEVENLABS_API_KEY" }] },
        { "id": "telegram", "required": false, "fields": [{ "name": "botToken", "secret": true, "env": "ELANOUS_TELEGRAM_BOT_TOKEN" }] },
        { "id": "telegram-chat", "required": false, "fields": [{ "name": "chatId", "secret": false, "env": "ELANOUS_TELEGRAM_CHAT_ID" }] }
      ]
    }
  }
}
