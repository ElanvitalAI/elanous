    "readonly scope is required",
    "write methods are rejected without mutation",
    "unknown hosts and endpoints fail closed",
    "captured requests never retain bearer values"
  ],
  "entryCommands": [
    "bun test src/ux-sim/fake-google-drive-world.test.ts"
  ],
  "logsRecorded": "no",
  "eventNames": [],
  "recentUse": null,
  "audience": "user",
  "defaultProfile": {
    "credentials": "fake-only",
    "network": "loopback-only",
    "storage": "temporary"
  }
}
