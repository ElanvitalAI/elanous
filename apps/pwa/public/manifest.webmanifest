{
  "name": "elanous",
  "short_name": "elanous",
  "description": "elanous — voice · chat · intake · control · terminal.",
  "start_url": "/app/chat",
  "scope": "/app/",
  "display": "standalone",
  "background_color": "#0b0f1a",
  "theme_color": "#0b0f1a",
  "permissions": ["microphone"],
  "icons": [
    { "src": "/app/icons/elanous-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/icons/elanous-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/app/share/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "video/*", "application/pdf", "text/plain", ".txt", ".md"]
        }
      ]
    }
  }
}
