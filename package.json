{
  "name": "elanous",
  "mcpName": "io.github.ElanvitalAI/elanous",
  "version": "0.2.13",
  "description": "Self-healing coding harness where eyes, hands, and memory all turn on one sentence — it authors its own goals, implements them in isolated worktrees, and reviews its own work.",
  "license": "Apache-2.0",
  "author": "Elanvital AI",
  "homepage": "https://elanous.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElanvitalAI/elanous.git"
  },
  "type": "module",
  "bin": {
    "elanous": "./bin/elanous.cjs",
    "eln": "./bin/elanous.cjs"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "files": [
    "bin/",
    "src/",
    "src/version/packed-revision.json",
    "scripts/",
    "skills/",
    "tools/",
    "widgets/",
    "plugins/",
    "templates/",
    "catalog/",
    "personas/",
    "persona-presets/",
    "examples/teams/",
    "graphs/",
    "apps/pwa/out/",
    ".python-version",
    ".bun-version",
    "requirements-python.txt",
    "requirements-python-extra.txt",
    ".rules/",
    "docs/goal-context/",
    "docs/design/craft/",
    "docs/design/systems/",
    "docs/mission-requests/",
    "docs/ad-presets/",
    "!**/*.test.ts",
    "!**/__snapshots__/**",
    "!**/*.log",
    "!**/*.pyc",
    "!**/__pycache__/**",
    ".env.example",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepack": "bun -e \"import { writePackagedRevision } from './src/version/code-revision.ts'; writePackagedRevision()\"",
    "postpack": "bun -e \"import { rmSync } from 'node:fs'; rmSync('src/version/packed-revision.json', { force: true })\"",
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "sync": "bun run src/index.ts sync",
    "status": "bun run src/index.ts status",
    "history": "bun run src/index.ts history",
    "smart": "bun run src/index.ts sync --smart",
    "search:eval": "bun run src/tool-search-eval.ts",
    "check:tool-wiring": "bun run scripts/check-native-tool-wiring.ts",
    "test:deterministic": "bun run scripts/test-deterministic.ts --dots",
    "test:tree-invariants": "bun test scripts/botlab/bot-canary-doc-commands.test.ts scripts/botlab/bot-canary-alarm-intent.test.ts scripts/botlab/bot-canary-binding-intent.test.ts scripts/botlab/heartbeat-stale-drill.test.ts scripts/botlab/heartbeat-exit-audit.test.ts scripts/botlab/tree-invariants-alias.test.ts",
    "gate:isolation": "bun run scripts/ci-isolation-hardcode-gate.ts",
    "gate:stdout-json": "bun run scripts/ci-stdout-json-gate.ts",
    "report:open-core-boundary": "bun run scripts/open-core-boundary.ts",
    "gate:shipped-devdep": "bun run scripts/ci-shipped-devdep-gate.ts",
    "gate:mock-module-restore": "bun run scripts/ci-mock-module-restore-gate.ts",
    "gate:android": "bun run scripts/ci-android-unit-tests.ts",
    "gate:ios": "bun run scripts/ci-ios-unit-tests.ts",
    "gen:cdp": "bun run scripts/gen-cdp-types.ts",
    "test:autopilot": "bun test src/autopilot/",
    "test:session-runtime-essential": "bun test src/session-runtime/coding-surface-shell.test.ts src/session-runtime/essential-profile-parity.test.ts test/session-runtime-essential-catalog.test.ts",
    "test:android": "bun run scripts/run-android-unit-tests.ts",
    "test:android-enter-key": "bun run scripts/run-chat-enter-key-android-tests.ts",
    "test:android-focused": "bun scripts/run-android-focused-tests.mjs",
    "test:android-nexus-routing": "bun scripts/run-android-nexus-routing-test.mjs",
    "postinstall": "bash -c 'find node_modules/node-pty/prebuilds -name spawn-helper -exec chmod +x {} \\; 2>/dev/null || true'",
    "check:codex-picker": "bun scripts/check-codex-picker-models.ts",
    "test:cdp": "bun run scripts/test-cdp.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.0",
    "@agentclientprotocol/claude-agent-acp": "0.81.2",
    "@agentclientprotocol/sdk": "1.5.0",
    "@antv/infographic": "^0.2.20",
    "@aws-sdk/client-secrets-manager": "^3.1043.0",
    "@discordjs/voice": "^0.19.2",
    "@google-cloud/secret-manager": "^6.1.2",
    "@google/gemini-cli": "0.38.0",
    "@google/genai": "^1.51.0",
    "@xterm/headless": "^6.0.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "diff": "^9.0.0",
    "libsodium-wrappers": "^0.8.4",
    "mammoth": "^1.12.0",
    "mermaidtui": "^0.0.5",
    "node-cron": "^4.2.1",
    "opusscript": "^0.1.1",
    "pdf-parse": "^2.4.5",
    "prism-media": "^1.3.5",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "typescript": "^5.7.0",
    "unified": "^11.0.5",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/diff": "^8.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/web-push": "^3.6.4",
    "devtools-protocol": "^0.0.1619965"
  }
}
