# elanous — external credentials
#
# ⛔ NOTHING HERE IS REQUIRED TO BOOT.
#    Measured 2026-09-20: with all 33 credential variables unset,
#    `elanous --version`, `elanous where`, `elanous config get` and `elanous usage`
#    all exit 0. Each key below unlocks one capability; missing keys
#    disable that capability, they do not stop the agent.
#
# Credentials are resolved from FOUR places, in this order of surprise:
#   1. this environment
#   2. ~/.cache/<lowercased name>       — read silently (src/config.ts:106)
#   3. ~/.claude/skills/<skill>/.env    — per-skill, outside this repo
#   4. elanous's own config (~/.elanous)    — e.g. registry.discovery.firecrawl.apiKey
# A fresh install has none of them. `elanous where` tells you which config
# directory is live.
#
# Some credentials accept SEVERAL names (fallback chains in the source).
# You only need to set ONE name per group — they are the same account.

# ─────────────────────────────────────────────────────────────────────
# LLM providers
# ─────────────────────────────────────────────────────────────────────
# The primary path is subscription OAuth, not API keys:
#   elanous login openai-codex     # ChatGPT device-code flow
# `elanous usage` shows which accounts are on file. Set the keys below only
# if you want metered API access instead of (or alongside) a subscription.
# Optional injection for Claude Code budget/usage checks; normal login uses CLI auth:
# CLAUDE_CODE_OAUTH_TOKEN=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROK_API_KEY=                  # same xAI account as XAI_API_KEY — either name works
GROK_CODE_XAI_API_KEY=         # same account again; scrubbed from child agents (billing path)

# One account, three accepted names (src/config.ts:213) — set any ONE:
ZHIPU_API_KEY=
# GLM_API_KEY=
# BIGMODEL_API_KEY=

# One account, two accepted names (src/config.ts:204) — set any ONE:
DASHSCOPE_API_KEY=
# QWEN_API_KEY=

# One account, two accepted names (src/config.ts:194) — set any ONE:
MOONSHOT_API_KEY=
# KIMI_API_KEY=
# OpenRouter — kimi·qwen·glm 의 실제 경로(provider `openrouter` · 모델 id `openrouter/<vendor>/<model>`).
#   이 기계 규약은 키 캐시 파일: bash scripts/add-api-key.sh OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Web search and crawling
# ─────────────────────────────────────────────────────────────────────
# ⭐ There is a FREE path that needs no key at all: the omni-crawl skill's
#    ddg + jina tier (skills/omni-crawl/src/free.ts — freeAvailable() is
#    unconditionally true). Search works without anything below.
#    Tavily is additionally gated OFF by config; turn it on with
#    `elanous config set webSearch.tavily.enabled true`.

# One account, two accepted names (src/web-search/tavily.ts:27) — set any ONE:
TAVILY_API_KEY=
# TAVILY_KEY=

FIRECRAWL_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Voice — text to speech, speech to text
# ─────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=            # src/voice/tts/tts-providers/elevenlabs-tts.ts
GOOGLE_API_KEY=                # Gemini Live STT

# ─────────────────────────────────────────────────────────────────────
# Content ingestion
# ─────────────────────────────────────────────────────────────────────
SUPADATA_API_KEY=              # YouTube transcripts
UPSTAGE_API_KEY=               # OCR
APIFY_TOKEN=                   # X / Twitter scraping
REDDIT_CLIENT_SECRET=          # Reddit community signals

# ─────────────────────────────────────────────────────────────────────
# Messaging
# ─────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=            # outbound alerts
ELANOUS_TELEGRAM_BOT_TOKEN=      # same token, env->config bridge spelling
ELANOUS_DISCORD_BOT_TOKEN=       # discord trigger bot, env->config bridge only
ELANOUS_TELEGRAM_HITL_BOT_TOKEN= # separate interaction-only bot preferred for HITL
ELANOUS_DISCORD_HITL_BOT_TOKEN=  # separate interaction-only bot for HITL
TELEGRAM_API_ID=               # MTProto user-account injection (scripts/)
TELEGRAM_API_HASH=

# ─────────────────────────────────────────────────────────────────────
# Assistant (email stays in assistantNoOauth config; secrets in the key cache)
# ─────────────────────────────────────────────────────────────────────
# Assistant IMAP app password and calendar ICS URL live in assistantNoOauth config,
# not in this repository's environment-credential resource map.

# ─────────────────────────────────────────────────────────────────────
# Development
# ─────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                  # docs lint + nightly docops scripts

# ─────────────────────────────────────────────────────────────────────
# Market data  ⚠️ domain add-on, not part of the general agent
# ─────────────────────────────────────────────────────────────────────
EODHD_API_KEY=
FDS_API_KEY=
KIS_APP_KEY=                   # Korea Investment & Securities
KIS_APP_SECRET=
TOSSINVEST_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Object storage & judgment — measured 2026-09-21, previously unlisted
# ─────────────────────────────────────────────────────────────────────
# These were read by shipped code but named in NEITHER this file nor
# catalog/resources.yaml. They were invisible because the sweep that
# built both looked only for `process.env.NAME`, and this repo injects
# `env` for testability and reads `env.NAME`.
AWS_ACCESS_KEY_ID=             # src/webclone/webclone-store.ts:180 — S3 store selection
AWS_SECRET_ACCESS_KEY=
TYPESAFE_API_KEY=              # src/decide/jev.ts:50 — Jev judgment (api.typesafe.ai)
                               # also read silently from ~/.cache (src/index.ts:1700)
ELANOUS_LLM_API_KEY=             # NOT a vendor: env spelling of llm.apiKey for whatever
                               # ELANOUS_LLM_PROVIDER selects (env-bridge.ts:30)

# ─────────────────────────────────────────────────────────────────────
# elanous's own shared secrets — generate your own, do not copy
# ─────────────────────────────────────────────────────────────────────
ELANOUS_TOKEN=                   # control-client auth
ELANOUS_HITL_SECRET=             # human-in-the-loop approval signing
ELANOUS_OPENAI_RELAY_SHARED_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Bundled skills — credentials read by skills/ , not by the core
# ─────────────────────────────────────────────────────────────────────
# The package ships 10 skills under `skills/`. Measured 2026-09-20: 26 names
# in that tree look like credentials, but only SIX have code that reads them.
# The other 20 are documentation placeholders (`YOUR_API_KEY`, `AUTH_KEY`, …)
# — do not go hunting for accounts to fill them.
#
#   APIFY_TOKEN               skills/omni-crawl/scripts/main.ts     (listed above)
#   FIRECRAWL_API_KEY         skills/omni-crawl/src/firecrawl.ts    (listed above)
#   TAVILY_API_KEY/_KEY       skills/omni-crawl/src/tavily.ts       (listed above)
#   TOSSINVEST_CLIENT_SECRET  skills/omni-market/src/providers/toss.ts (listed above)
#   JINA_API_KEY              skills/omni-crawl/src/free.ts         ← only new one

# Optional. The free crawl tier calls r.jina.ai without any key; this key only
# raises its rate limit (skills/omni-crawl/src/free.ts:104 — the Authorization
# header is added only when the key is present). Leave it empty and free
# crawling still works.
JINA_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Deliberately not listed above
# ─────────────────────────────────────────────────────────────────────
# TG_TOKEN is a manual dogfood script alias (scripts/c5-telegram-stream-dogfood.ts),
# not a production account. Set TELEGRAM_BOT_TOKEN for the real bot instead.
# TG_TOKEN=
