{
  "$schema": "https://antigravity.google/schemas/v1/plugin.json",
  "name": "elanous-hwp",
  "version": "0.1.1",
  "description": "Read HWP/HWPX, write template-based HWPX, and fill existing HWPX forms.",
  "extensions": {
    "ai.elanous": {
      "skills": ["skills/hwp-read", "skills/hwp-write", "skills/hwp-fill"],
      "nodes": ["./nodes/to-md.yaml", "./nodes/from-md.yaml"],
      "capabilities": ["fs:workdir", "proc:python3"],
      "connectors": [],
      "requires": { "tools": ["python3"], "optionalPython": ["pyhwp"] },
      "pricing": { "model": "free" },
      "trust": "official",
      "category": "Productivity"
    }
  }
}
